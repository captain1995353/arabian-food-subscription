# ======================================================================
# Arabian Food Subscription — Environment Variables
# Copy this file to ".env.local" and fill in your Supabase project values.
# Find these in: Supabase Dashboard -> Project Settings -> API
# ======================================================================

# Public Supabase URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used for admin/server actions that must bypass RLS (e.g. seeding,
# privileged reporting). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Name of the Supabase Storage bucket that holds food images.
# Create a PUBLIC bucket with this name in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_FOOD_BUCKET=food-images

# Public site URL (used for auth redirects). For local dev keep as is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret invite code required to register an ADMIN account at /admin/register.
# SERVER ONLY. Change this to a strong secret and share it only with staff.
# Leave empty to fully disable self-service admin sign-up.
ADMIN_SIGNUP_CODE=ARABIAN-ADMIN-2026
